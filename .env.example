# ─────────────────────────────────────────────────────────────
# Backend environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# Runtime mode. Use "pro" in production (selects DB_PRO_URL), anything else
# is treated as local/development (selects DB_LOCAL_URL).
mode=dev

# Standard Node environment. Set to "production" on your host so security
# cookies (secure/sameSite=none) and quiet logging are enabled.
NODE_ENV=development

# HTTP port the server listens on.
PORT=5000

# MongoDB connection strings.
DB_PRO_URL=mongodb+srv://<user>:<password>@<cluster>/<db>?appName=Cluster0
DB_LOCAL_URL=mongodb://127.0.0.1:27017/ecommerce

# JWT signing secret. Use a long, random string in production.
SECRET=change-me-to-a-long-random-secret

# Stripe secret key (server-side).
STRIPE_SECRET_KEY=your_stripe_secret_key

# Cloudinary credentials for image uploads.
cloud_name=your_cloud_name
api_key=your_cloudinary_api_key
api_secret=your_cloudinary_api_secret

# Comma-separated list of additional allowed CORS origins (frontend + dashboard).
# Defaults already include the known Vercel and localhost origins.
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001

# Base URL of the seller dashboard (used for Stripe Connect return/refresh URLs).
DASHBOARD_URL=http://localhost:3001

# Admin bootstrap controls for the protected create_admin endpoint.
# In non-production you may set ALLOW_ADMIN_BOOTSTRAP=true to seed the first admin.
# Otherwise the request must send an `x-setup-key` header matching ADMIN_SETUP_KEY.
ALLOW_ADMIN_BOOTSTRAP=false
ADMIN_SETUP_KEY=

# ─────────────────────────────────────────────────────────────
# Social login (Google + Facebook). All optional — leave blank to disable.
# These are used to VERIFY tokens the frontend/dashboard send after the user
# signs in with Google/Facebook. Use the SAME Google client id here and in the
# frontend/dashboard REACT_APP_GOOGLE_CLIENT_ID so audience checks pass.
# ─────────────────────────────────────────────────────────────
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# (Web application). Add your frontend/dashboard origins to "Authorized
# JavaScript origins" (e.g. http://localhost:3000 and http://localhost:3001).
GOOGLE_CLIENT_ID=

# Facebook for Developers > your app > Settings > Basic.
# App secret is used server-side to validate tokens (debug_token); never expose it.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
